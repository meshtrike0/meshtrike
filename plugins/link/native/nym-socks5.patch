+//! Meshtrike patch: an optional SOCKS5 route for the gateway WebSocket.
+//!
+//! When set, every gateway connection is opened through this proxy (with
+//! username/password authentication) and the gateway's hostname is resolved
+//! by the proxy, so the client itself makes no DNS lookup and no direct TCP
+//! connection. Unset (the default), behaviour is unchanged.
+
+use std::net::SocketAddr;
+use std::sync::RwLock;
+
+#[derive(Clone)]
+pub struct Socks5 {
+    pub addr: SocketAddr,
+    pub user: String,
+    pub pass: String,
+}
+
+static PROXY: RwLock<Option<Socks5>> = RwLock::new(None);
+
+pub fn set_socks5_proxy(proxy: Option<Socks5>) {
+    *PROXY.write().unwrap_or_else(|p| p.into_inner()) = proxy;
+}
+
+pub(crate) fn socks5_proxy() -> Option<Socks5> {
+    PROXY.read().unwrap_or_else(|p| p.into_inner()).clone()
+}
+
+static LAST_TARGET: RwLock<Option<String>> = RwLock::new(None);
+
+/// The gateway ("host:port") the last proxied connection asked the proxy to
+/// reach: the real gateway behind a bridge, for opt-in tracing.
+pub fn last_socks5_target() -> Option<String> {
+    LAST_TARGET.read().unwrap_or_else(|p| p.into_inner()).clone()
+}
+
+pub(crate) fn set_last_socks5_target(t: String) {
+    *LAST_TARGET.write().unwrap_or_else(|p| p.into_inner()) = Some(t);
+}
